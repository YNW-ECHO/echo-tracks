<?xml version="1.0" encoding="utf-8"?>
<!-- Echo Tracks foreground: mint echo waves + amber pulse on midnight. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
<!-- midnight base comes from ic_launcher_background — keep foreground transparent
     so the launcher can mask circle/squircle correctly. -->
    <!-- outer echo ring -->
    <path android:fillColor="#00000000" android:strokeColor="#00E5A0"
        android:strokeWidth="5" android:strokeLineCap="round"
        android:pathData="M54,14a40,40 0 1,1 -0.1,0" />
    <!-- middle echo arc (gap = sound wave) -->
    <path android:fillColor="#00000000" android:strokeColor="#5BD8C8"
        android:strokeWidth="6" android:strokeLineCap="round"
        android:pathData="M22,68a40,40 0 0,1 10,-34" />
    <path android:fillColor="#00000000" android:strokeColor="#5BD8C8"
        android:strokeWidth="6" android:strokeLineCap="round"
        android:pathData="M86,68a40,40 0 0,0 -10,-34" />
    <!-- core mint coin -->
    <path android:fillColor="#00E5A0"
        android:pathData="M54,34a20,20 0 1,1 -0.1,0z" />
    <!-- E cut -->
    <path android:fillColor="#0E1A2B"
        android:pathData="M48,46h12v4h-12zM48,52h10v4h-10zM48,58h12v4h-12zM46,46h4v16h-4z" />
    <!-- amber pulse dot -->
    <path android:fillColor="#FFB020"
        android:pathData="M78,78a7,7 0 1,1 -0.1,0z" />
</vector>
